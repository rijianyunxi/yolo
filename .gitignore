# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# Node / 前端
node_modules/
webui/frontend/node_modules/

# 运行时生成物
webui/uploads/
webui/task_logs/
webui/uvicorn.pid
webui/task_history.json
runs/

# 模型权重（可重新下载或训练得到）
*.pt

# 数据集图片/标签（仅提交配置 yaml，不提交数据）
# 标准布局: datasets/<name>/images/<split>
datasets/*/images/
datasets/*/labels/
# Roboflow 布局: datasets/<name>/<split>/images（如 safety2）
datasets/*/*/images/
datasets/*/*/labels/

# 测试/截图
test_images/
.tmp-pw/

# 操作系统 / 编辑器
.DS_Store
Thumbs.db
.idea/
.vscode/

# 数据集质量检查运行时报告
webui/reports/
# 缩略图缓存（运行时生成，可由源图片重新生成）
webui/thumbnails/

# Playwright / E2E 临时产物
webui/frontend/.e2e-dist/
webui/frontend/test-results/
